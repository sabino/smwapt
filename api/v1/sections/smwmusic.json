  {
    "name": "smwmusic-immaculate-sense-in-darkness-eyes-shut",
    "aliases": [],
    "section": "smwmusic",
    "upstream_id": 42869,
    "title": "Immaculate Sense in Darkness ~ Eyes Shut",
    "authors": [
      "Archbishop Weeble-Wobble",
      "Hooded Edge"
    ],
    "tags": [
      "athletic",
      "boss",
      "chase",
